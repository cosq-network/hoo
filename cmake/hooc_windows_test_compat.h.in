#pragma once

#ifdef _WIN32
#include <stdlib.h>

static inline int hooc_win_setenv(const char* name, const char* value, int overwrite) {
    if (!overwrite) {
        size_t existing_len = 0;
        if (_dupenv_s(nullptr, &existing_len, name) == 0 && existing_len != 0) {
            return 0;
        }
    }
    return _putenv_s(name, value);
}

static inline int hooc_win_unsetenv(const char* name) {
    return _putenv_s(name, "");
}

#define setenv hooc_win_setenv
#define unsetenv hooc_win_unsetenv
#endif
