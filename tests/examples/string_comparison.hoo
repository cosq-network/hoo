// Test string comparison operations
func test_equality() -> void {
    var str1 = "hello";
    var str2 = "hello";
    var str3 = "world";

    if (str1 == str2) {
        hoo_string_println("str1 equals str2");
    }

    if (str1 != str3) {
        hoo_string_println("str1 not equal to str3");
    }
}

func test_ordering() -> void {
    var apple = "apple";
    var banana = "banana";
    var cherry = "cherry";

    if (apple < banana) {
        hoo_string_println("apple < banana");
    }

    if (banana < cherry) {
        hoo_string_println("banana < cherry");
    }

    if (cherry > apple) {
        hoo_string_println("cherry > apple");
    }
}

func test_combined() -> void {
    var a = "test";
    var b = "test";

    if (a == b) {
        hoo_string_println("Match found");
    }
}

func main() -> void {
    test_equality();
    test_ordering();
    test_combined();
}
