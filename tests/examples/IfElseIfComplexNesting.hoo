
        func test(x: int64, y: int64) -> int64 {
            if (x > 0) {
                if (y > 0) {
                    return 1;
                } else {
                    return 2;
                }
            } else {
                if (x == 0) {
                    if (y > 0) {
                        return 3;
                    } else {
                        return 4;
                    }
                } else {
                    if (y > 0) {
                        return 5;
                    } else {
                        return 6;
                    }
                }
            }
        }
    