func array_iteration() -> int64 {
    // Conceptual example showing array + for loop integration
    var data: int64[8];
    var sum = 0;
    
    // Initialize array (conceptually)
    for i in 0..8 {
        // data[i] = i * i; // Assignment would need more implementation
    }
    
    // Sum array elements
    for value in data {
        sum = sum + value;
    }
    
    return sum;
}

