func search_example() -> bool {
    var array: int64[10];
    var target = 42;
    var found = false;
    
    // Linear search with for-in loop
    for element in array {
        if (element == target) {
            found = true;
            // break; // Break statement would need implementation
        }
    }
    
    return found;
}