
        func test(index: int64) -> int64 {
            var arr = [10, 20, 30, 40, 50];
            if (index < 2) {
                return arr[0];
            } else {
                if (index < 4) {
                    return arr[2];
                } else {
                    return arr[4];
                }
            }
        }
    