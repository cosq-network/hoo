// Example: Generic Utility Functions
// Demonstrates generic functions that work with any type

func identity<T>(value: T) -> int64 {
    // Identity function: returns the value as-is
    // (return type is int64 for simplicity in this example)
    return 0;
}

func process<T>(value: T) -> int64 {
    // Process function: does something with the value
    return 42;
}

func combine<T, U>(a: T, b: U) -> int64 {
    // Combine function: works with two different types
    return 100;
}

func main() {
    // Use generic functions with different types
    var result1 = identity<int64>(42);
    var result2 = identity<double>(3.14);
    var result3 = identity<string>("hello");

    // Process with different types
    var processed1 = process<int64>(10);
    var processed2 = process<string>("data");

    // Combine different types
    var x: int64 = 5;
    var y: double = 2.5;
    var combined = combine<int64, double>(x, y);
}
