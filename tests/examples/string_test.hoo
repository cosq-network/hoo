// Test string literals and operations
func test_string_literals() -> void {
    var greeting = "Hello";
    var name = "World";
    var message = greeting + ", " + name + "!";
    hoo_string_println(message);
}

func test_string_comparison() -> void {
    var str1 = "hello";
    var str2 = "hello";
    var str3 = "world";

    if (str1 == str2) {
        hoo_string_println("str1 equals str2");
    }

    if (str1 != str3) {
        hoo_string_println("str1 not equal to str3");
    }
}

func main() -> void {
    test_string_literals();
    test_string_comparison();
}
