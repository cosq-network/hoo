
        func test(value: int64) -> int64 {
            if (value < 10) {
                return 1;
            } else {
                if (value < 50) {
                    return 2;
                } else {
                    if (value < 100) {
                        return 3;
                    } else {
                        return 4;
                    }
                }
            }
        }
    