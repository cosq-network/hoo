
        func test(x: int64, y: int64) -> int64 {
            var result = 0;
            if (x < 3) {
                result = 1;
            } else {
                if (x < 7) {
                    result = 2;
                } else {
                    result = 3;
                }
            }

            if (y < 5) {
                result = result + 10;
            } else {
                if (y < 15) {
                    result = result + 20;
                } else {
                    result = result + 30;
                }
            }
            return result;
        }
    