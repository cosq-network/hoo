
        func test() -> void {
            var a = 0;
            while (a < 2) {
                var b = 0;
                while (b < 2) {
                    var c = 0;
                    while (c < 2) {
                        c = c + 1;
                    }
                    b = b + 1;
                }
                a = a + 1;
            }
        }
    