// Example: Generic Array Wrapper Class
// Demonstrates a generic class that holds an array of type T

class ArrayWrapper<T> {
    var elements: int64[]; // Simplified to int64[] as current arrays are non-generic in hooc.
                            // In a fully generic system, this would be T[].
    var size: int64;

    constructor(initialSize: int64) {
        size = initialSize;
        // Assume allocation for 'elements' happens here,
        // but current hooc array literals are explicit
        // elements = new T[size]; // Conceptual
    }

    func set(index: int64, value: int64) -> void { // value should conceptually be T
        // elements[index] = value; // Conceptual
        return;
    }

    func get(index: int64) -> int64 { // return should conceptually be T
        // return elements[index]; // Conceptual
        return 0; // Dummy return
    }

    func getSize() -> int64 {
        return size;
    }
}

func main() {
    var intArrayWrapper = new ArrayWrapper<int64>(5);
    var doubleArrayWrapper = new ArrayWrapper<double>(10);
    var stringArrayWrapper = new ArrayWrapper<string>(3);

    intArrayWrapper.set(0, 10);
    var firstInt = intArrayWrapper.get(0);

    // Conceptually:
    // stringArrayWrapper.set(0, "first");
    // var firstString = stringArrayWrapper.get(0);
}
