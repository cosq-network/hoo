// Example: Generic Container Class
// Demonstrates a generic container that works with any type

class Container<T> {
    constructor() {
    }

    func store(item: T) -> void {
        // Store the item
    }

    func retrieve() -> T {
        // Retrieve the stored item (dummy implementation)
        return 0;
    }
}

func main() {
    // Create containers for different types
    var intContainer = new Container<int64>();
    var doubleContainer = new Container<double>();
    var stringContainer = new Container<string>();

    // Each container is specialized for its type
    intContainer.store(42);
    doubleContainer.store(3.14);
    stringContainer.store("hello");
}
