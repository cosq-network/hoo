
        func test(ch: char) -> int64 {
            if (ch == 'a') {
                return 1;
            } else {
                if (ch == 'b') {
                    return 2;
                } else {
                    if (ch == 'c') {
                        return 3;
                    } else {
                        return 0;
                    }
                }
            }
        }
    