func char_comparison() -> bool {
    var ch1 = 'A';
    var ch2 = 'B';
    var ch3 = 'A';
    
    var equal = ch1 == ch3;
    var not_equal = ch1 != ch2;
    var less = ch1 < ch2;
    var greater = ch2 > ch1;
    var less_equal = ch1 <= ch2;
    var greater_equal = ch2 >= ch1;
    
    return equal && not_equal;
}

func classify_char(ch: char) -> int {
    if (ch >= 'A' && ch <= 'Z') {
        return 1; // uppercase
    } else if (ch >= 'a' && ch <= 'z') {
        return 2; // lowercase
    } else if (ch >= '0' && ch <= '9') {
        return 3; // digit
    } else {
        return 0; // other
    }
}