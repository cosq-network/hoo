
        func test(x: int64) -> int64 {
            if (x == 1) {
                return 1;
            } else {
                if (x == 2) {
                    return 2;
                } else {
                    if (x == 3) {
                        return 3;
                    } else {
                        if (x == 4) {
                            return 4;
                        } else {
                            if (x == 5) {
                                return 5;
                            } else {
                                return 0;
                            }
                        }
                    }
                }
            }
        }
    