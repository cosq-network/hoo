
        func test(flag1: bool, flag2: bool) -> int64 {
            if (flag1 && flag2) {
                return 1;
            } else {
                if (flag1) {
                    return 2;
                } else {
                    if (flag2) {
                        return 3;
                    } else {
                        return 0;
                    }
                }
            }
        }
    