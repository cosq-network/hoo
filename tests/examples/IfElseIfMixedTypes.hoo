
        func test(intVal: int64, floatVal: double, boolVal: bool) -> int64 {
            if (intVal > 0) {
                return 1;
            } else {
                if (floatVal > 2.0) {
                    return 2;
                } else {
                    if (boolVal) {
                        return 3;
                    } else {
                        return 0;
                    }
                }
            }
        }
    