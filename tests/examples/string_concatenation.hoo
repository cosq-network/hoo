// Test string concatenation with multiple operations
func concatenation_test() -> void {
    var greeting = "Hello";
    var comma = ", ";
    var name = "Alice";
    var exclaim = "!";

    var message = greeting + comma + name + exclaim;
    hoo_string_println(message);
}

func multi_line_concat() -> void {
    var line1 = "The";
    var line2 = " quick";
    var line3 = " brown";
    var line4 = " fox";

    var result = line1 + line2 + line3 + line4;
    hoo_string_println(result);
}

func main() -> void {
    concatenation_test();
    multi_line_concat();
}
