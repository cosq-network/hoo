
        func test(x: int64, y: int64) -> int64 {
            if (x + y > 20) {
                return 1;
            } else {
                if (x - y > 3) {
                    return 2;
                } else {
                    if (x * y > 40) {
                        return 3;
                    } else {
                        return 4;
                    }
                }
            }
        }
    