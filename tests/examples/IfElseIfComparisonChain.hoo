
        func test(x: int64) -> int64 {
            if (x < 10) {
                return 1;
            } else {
                if (x >= 10 && x < 20) {
                    return 2;
                } else {
                    if (x >= 20 && x < 30) {
                        return 3;
                    } else {
                        return 4;
                    }
                }
            }
        }
    